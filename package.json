{
  "name": "node-express-sequelize-template",
  "version": "1.0.0",
  "description": "Layered Express 5 + Sequelize (MySQL) REST API template",
  "main": "src/index.js",
  "type": "commonjs",
  "license": "ISC",
  "author": "surya",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:create": "sequelize db:create",
    "db:migrate": "sequelize db:migrate",
    "db:migrate:undo": "sequelize db:migrate:undo",
    "db:migrate:undo:all": "sequelize db:migrate:undo:all",
    "db:seed": "sequelize db:seed:all",
    "db:seed:undo": "sequelize db:seed:undo:all",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "http-status-codes": "^2.3.0",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
